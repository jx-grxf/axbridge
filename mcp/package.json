{
  "name": "axbridge-mcp",
  "version": "0.1.1",
  "description": "MCP server that lets coding agents drive iOS Simulator apps as text: read the screen from the accessibility tree, tap by name, type, scroll, plus device, app and screenshot tools.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ios",
    "ios-simulator",
    "simulator",
    "xcode",
    "swiftui",
    "accessibility",
    "ui-testing",
    "claude-code",
    "codex",
    "cursor",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "Johannes Grof",
  "homepage": "https://github.com/jx-grxf/axbridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jx-grxf/axbridge.git",
    "directory": "mcp"
  },
  "bugs": "https://github.com/jx-grxf/axbridge/issues",
  "type": "module",
  "bin": {
    "axbridge-mcp": "dist/index.js",
    "axbridge": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
